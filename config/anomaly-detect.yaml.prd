models:
  - id: "water-hammer-z-score"
    enabled: true
    kind: "univariate"
    algorithm: "z_score"
    inputs: ["water_line_pressure"]
    parameters: { ddof: 1 }
    thresholds: { score: 5.0 }
  - id: "water-hammer-mad"
    enabled: true
    kind: "univariate"
    algorithm: "mad"
    inputs: ["water_line_pressure"]
    thresholds: { score: 8.0 }
