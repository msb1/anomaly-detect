kafka:
  brokers: "192.168.1.50:9092,192.168.1.50:9094,192.168.1.50:9096"
  topic: "iot.telemetry.v1"
  output_topic: "iot.anomaly.v1"
  group_id: "anomaly-detect-industrial-scenarios-v1"
  client_id: "anomaly-detect-industrial-scenarios"
  auto_offset_reset: "latest"
  invalid_message_policy: "skip"
  logging: { log_consumed_messages: true, log_produced_results: true }
  security: { security_protocol: null, sasl_mechanism: null, username: null, password: null }

window: { sample_count: 128 }
preprocessing:
  interpolation: { enabled: true, max_gap_fraction: 0.20 }
  scaling: { enabled: false, method: "standard", output_min: 0.0, output_max: 1.0, epsilon: 0.000000000001 }
  decomposition:
    trend: { enabled: false, alpha: 0.2, beta: 0.1 }
    seasonal:
      enabled: false
      window_size_samples: 48
      detection_interval_samples: 1
      min_period_samples: 2
      max_period_samples: 24
  smoothing: { enabled: false, method: "moving_average", window_size: 5 }

streams:
  water_line_pressure:
    headers: { entity_id: "municipal_water_system_01", sensor_id: "water-line-pressure-01", sensor_type: "scenario_signal", metric: "line_pressure_psi" }
  # rack_temperature:
  #   interval_ms: 60000
