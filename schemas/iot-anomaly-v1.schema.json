{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anomaly-detect.local/schemas/iot-anomaly-v1.schema.json",
  "title": "IoT anomaly detection result",
  "type": "object",
  "required": [
    "schema_version",
    "timestamp_ms",
    "model_id",
    "model_kind",
    "algorithm",
    "score_algorithm",
    "inputs",
    "anomalous_points",
    "window_sample_count",
    "is_anomalous",
    "anomaly_score",
    "details"
  ],
  "properties": {
    "schema_version": { "const": "iot.anomaly.v1" },
    "timestamp_ms": { "type": "integer" },
    "model_id": { "type": "string", "minLength": 1 },
    "model_kind": { "enum": ["univariate", "multivariate"] },
    "algorithm": { "type": "string", "minLength": 1 },
    "score_algorithm": { "enum": ["z_score", "mad", "raw"] },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "anomalous_points": { "type": "integer", "minimum": 0 },
    "window_sample_count": { "type": "integer", "minimum": 1 },
    "is_anomalous": { "type": "boolean" },
    "anomaly_score": { "type": ["number", "null"] },
    "details": { "type": "object" }
  },
  "additionalProperties": false
}
